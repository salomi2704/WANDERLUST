<div class="row">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <% if(success && success.length) {%>
    <div class="alert alert-success alert-dismissible fade show mt-3 shadow-xs rounded-3 border-0" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%=success%>
      <button 
      type="button" 
      class="btn-close" 
      data-bs-dismiss="alert" 
      aria-label="Close">
      </button>
    </div>
    <%}%>

    <% if(error && error.length) {%>
    <div class="alert alert-danger alert-dismissible fade show mt-3 shadow-xs rounded-3 border-0" role="alert">
      <i class="fa-solid fa-circle-exclamation me-2"></i><%=error %>
      <button 
      type="button" 
      class="btn-close" 
      data-bs-dismiss="alert" 
      aria-label="Close">
      </button>
    </div>
    <%}%>
  </div>
</div>
