    <% layout("/layouts/boiler_plate")-%>
    
    <div class="row mt-3">
    <div class="col-8 offset-2">
    <form method="POST" action="/listings">
        <h3>Create a New Listing</h3>
        <div class="mb-3">
        <label for="title" class="form-label">Enter Title</label>
        <input type="text" name="listing[title]" class="form-control" placeholder="Enter title">
        </div>
        
        <div class="mb-3">
        <label for="description"  class="form-label">Description</label>
        <textarea type="text" name="listing[description]" type="text" class="form-control" placeholder="Enter description"></textarea>
        </div>
        
        <div class="mb-3">
            <label for="image" class="form-label">Image Link</label>
            <input type="text" name="lisitng[image]" class="form-control" placeholder=" Enter imageURL">
        </div>
        
        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <br>
            <input type="number" class="form-control" name="listing[price]" placeholder="Enter price">
        </div>
        
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" class="form-control" name="listing[country]"  placeholder="Enter country">
        </div>
        </div>
            <div class="mb-3 ">
            <label for="location" class="form-label" >Location</label>
            <input type="text" name="listing[location]"  placeholder="Enter location">
        </div>
        <button class="btn btn-dark mb-3 add-btn mt-3">Add</button>
    </div>
    
        <br/><br/>
        
    </div>
    </form>

    
            
    