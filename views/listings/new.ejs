<% layout("/layouts/boiler_plate")-%>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      <h3>Create a New Listing</h3>

      <div class="mb-3">
        <label for="title" class="form-label">Enter Title</label>
        <input type="text" required name="listing[title]" class="form-control" placeholder="Enter title">
        <div class="valid-feedback">Title Looks good!</div>
    </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea required name="listing[description]" class="form-control" placeholder="Enter description"></textarea>
        <div class="valid-feedback">Please enter a short description</div>
    </div>

      <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image</label>
        <input type="file" name="listing[image]" class="form-control" required>
        <div class="invalid-feedback">Please upload an image</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input type="number" required class="form-control" name="listing[price]" placeholder="Enter price">
        <div class="invalid-feedback">Price should be valid</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input type="text" required class="form-control" name="listing[country]" placeholder="Enter country">
        <div class="invalid-feedback">Country name should be valid</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select name="listing[category]" id="category" class="form-select" required>
          <option value="Trending" selected>Trending</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic Cities">Iconic Cities</option>
          <option value="Mountains">Mountains</option>
          <option value="Castles">Castles</option>
          <option value="Amazing Pools">Amazing Pools</option>
          <option value="Camping">Camping</option>
          <option value="Farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Domes">Domes</option>
          <option value="Boats">Boats</option>
          <option value="Beachfront">Beachfront</option>
        </select>
        <div class="invalid-feedback">Please select a category</div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input type="text" required class="form-control" name="listing[location]" placeholder="Enter location">
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <button class="btn btn-dark mb-3 add-btn mt-3">Add</button>
    </form>
  </div>
</div>

<script>
  // Disable form submission if invalid fields exist
  (function () {
    'use strict'
    var forms = document.querySelectorAll('.needs-validation')

    Array.prototype.slice.call(forms).forEach(function (form) {
      form.addEventListener('submit', function (event) {
        if (!form.checkValidity()) {
          event.preventDefault()
          event.stopPropagation()
        }
        form.classList.add('was-validated')
      }, false)
    })
  })()
</script>
