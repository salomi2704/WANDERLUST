<% layout("/layouts/boiler_plate")%>
<div class="row">
    <div class="col-8 offset-3">
    <h3>Listing Details:</h3>
    </div>
    <div class="card col-6 show-card offset-3">
  <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image"/>
  <div class="card-body">
    <p class="card-text">
        <b><%=listing.title%></b>
        <br><br>
        <%=listing.title%> <br>
        &#8377;<%=listing.price.toLocaleString("en-IN")%> <br>
        <%=listing.location%> <br>
        <%=listing.country%><br>
    </p>

    <br><br>
  </div>
</div>
<br>
<div class="btns">
<a href="/listings/<%= listing._id %>/edit" class="btn link btn-dark col-1 offset-3 edit-btn">Edit</a>
<br><br>
<form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
    <button class="btn btn-dark link offset-5">Delete</button>
</form>
</div>
</div>

