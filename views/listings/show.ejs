<% layout("/layouts/boiler_plate")%>
<div class="row mt-3 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <h3 class="mb-3 fw-bold fs-4 fs-md-3"><%= listing.title %></h3>
  </div>

  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 show-card">
    <div class="show-img-container overflow-hidden rounded-4 mb-3 shadow-sm">
      <img src="<%= listing.image && listing.image.url ? listing.image.url : '/images/default.jpg' %>" class="card-img-top show-img" alt="listing_image"/>
    </div>
    <div class="card-body">
      <p class="card-text text-muted mb-2">
        Hosted by <strong class="text-dark"><%= listing.owner ? listing.owner.username : 'Wanderlust Host' %></strong>
      </p>
      <% if (listing.category) { %>
        <p class="card-text mb-3">
          <a href="/listings?category=<%= encodeURIComponent(listing.category) %>" class="badge bg-light text-dark border text-decoration-none px-3 py-2 rounded-pill">
            <i class="fa-solid fa-tag text-danger me-1"></i> <%= listing.category %>
          </a>
        </p>
      <% } %>
      <p class="card-text listing-desc lh-lg mb-3">
        <%= listing.description %>
      </p>
      <div class="listing-details-box p-3 bg-light rounded-3 border mb-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div>
            <span class="text-muted small d-block">Price</span>
            <% if (listing.price != null) { %>
              <span class="fs-5 fw-bold text-dark">&#8377;<%= Number(listing.price).toLocaleString("en-IN") %></span>
              <span class="text-muted small"> / night</span>
            <% } else { %>
              <span class="text-muted">Price not available</span>
            <% } %>
          </div>
          <div>
            <span class="text-muted small d-block">Location</span>
            <span class="fw-semibold text-dark"><i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
  <div class="btns col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mt-2 mb-3 d-flex align-items-center gap-2">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4">Edit</a>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
      <button class="btn btn-outline-dark px-4">Delete</button>
    </form>
  </div>
  <% } %>

  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mb-3">
    <% if (currentUser) { %>
    <hr class="my-4">
    <h4 class="mb-3">Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation review-form p-3 p-sm-4 border rounded-4 bg-light">
      <div class="mb-3">
        <label for="rating" class="form-label fw-semibold">Rating</label>
        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
          <input type="radio" id="first-rate1" name="review[rating]" value="1" />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input type="radio" id="first-rate2" name="review[rating]" value="2" />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input type="radio" id="first-rate3" name="review[rating]" value="3" />
          <label for="first-rate3" title="Average">3 stars</label>
          <input type="radio" id="first-rate4" name="review[rating]" value="4" />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input type="radio" id="first-rate5" name="review[rating]" value="5" />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-3">
        <label for="comment" class="form-label fw-semibold">Comments</label>
        <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control" placeholder="Share your experience with this place..." required></textarea>
        <div class="invalid-feedback">Please enter your comments</div>
      </div>
      <button class="btn btn-dark px-4 rounded-pill">Submit Review</button>
    </form>
    <% } %>

    <% if (listing.reviews && listing.reviews.length > 0) { %>
    <hr class="my-4"/>
    <h4 class="mb-3">All Reviews <span class="badge bg-secondary rounded-pill fs-6 align-middle"><%= listing.reviews.length %></span></h4>
    <div class="row g-3">
      <% for (let review of listing.reviews) { %>
      <div class="col-12 col-md-6">
        <div class="card h-100 review-card shadow-xs p-3">
          <div class="card-body p-0">
            <div class="d-flex align-items-center mb-2">
              <div class="avatar-circle me-2 bg-dark text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                <%= (review.author && review.author.username) ? review.author.username.charAt(0).toUpperCase() : 'A' %>
              </div>
              <h5 class="card-title fs-6 mb-0 fw-semibold">@<%= review.author ? review.author.username : 'Anonymous' %></h5>
            </div>
            <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
            <p class="card-text text-muted mb-0 small"><%= review.comment %></p>
          </div>
          <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
          <form class="mt-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
          </form>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mb-4">
    <hr class="my-4"/>
    <h4 class="mb-2">Where you'll be</h4>
    <p class="text-muted mb-3"><i class="fa-solid fa-location-dot me-2 text-danger"></i><%= listing.location %>, <%= listing.country %></p>
    <div id="map" class="shadow-sm"></div>
  </div>
</div>

<script>
  const listingData = {
    title: <%- JSON.stringify(listing.title) %>,
    location: <%- JSON.stringify(listing.location) %>,
    country: <%- JSON.stringify(listing.country) %>,
    coordinates: <%- JSON.stringify(listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2 ? listing.geometry.coordinates : [77.2090, 28.6139]) %>
  };
</script>
<script src="/js/map.js"></script>
