<% layout("/layouts/boiler_plate")-%>
<body>
  <h3>All Listings</h3>
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of allListings){ %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card" style="width: 20rem;">
          <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?ixlib=rb-4.0.3' %>" class="card-img-top" style="height:20rem" alt="listing_image">
          <div class="card-body">
            <p class="card-text">
<% if (listing.price != null) { %>
  &#8377;<%= Number(listing.price).toLocaleString("en-IN") %>/night
<% } else { %>
  <span>Price not available</span>
<% } %>

            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
</body>
