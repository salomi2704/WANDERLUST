<%layout("/layouts/boiler_plate")%>
<div class="row mt-5 mb-5">
  <div class="col-12 col-md-8 col-lg-6 mx-auto">
    <div class="alert alert-danger p-4 rounded-4 shadow-sm border-0" role="alert">
      <div class="d-flex align-items-center mb-2">
        <i class="fa-solid fa-triangle-exclamation fs-3 text-danger me-2"></i>
        <h4 class="alert-heading mb-0 fw-bold">Oops! Something went wrong</h4>
      </div>
      <hr>
      <p class="mb-3"><%=message%></p>
      <a href="/listings" class="btn btn-danger rounded-pill px-4">Back to Home</a>
    </div>
  </div>
</div>
