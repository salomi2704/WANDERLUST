<% layout("/layouts/boiler_plate")-%>

<div class="row mt-4 mb-5">
    <div class="col-12 col-sm-9 col-md-7 col-lg-5 mx-auto">
        <div class="auth-card p-4 p-sm-5 bg-white border rounded-4 shadow-xs">
            <h2 class="mb-4 fw-bold text-center">Sign Up for Wanderlust</h2>
            <form action="/signup" method="POST" class="needs-validation" novalidate>

                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold">Username</label>
                    <input type="text" id="username" required class="form-control py-2" name="username" placeholder="Choose a username" autocomplete="username">
                    <div class="invalid-feedback">Please choose a username</div>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold">Email Address</label>
                    <input type="email" id="email" required class="form-control py-2" name="email" placeholder="name@example.com" autocomplete="email">
                    <div class="invalid-feedback">Please enter a valid email</div>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label fw-semibold">Password</label>
                    <input type="password" id="password" required class="form-control py-2" name="password" placeholder="Create a strong password" autocomplete="new-password">
                    <div class="invalid-feedback">Please enter a password</div>
                </div>

                <button class="btn btn-dark w-100 py-2 fw-semibold rounded-3 mb-3" type="submit">Create Account</button>
                <div class="text-center text-muted small">
                    Already have an account? <a href="/login" class="text-danger fw-semibold text-decoration-none">Log In</a>
                </div>
            </form>
        </div>
    </div>
</div>